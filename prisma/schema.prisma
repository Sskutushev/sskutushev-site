generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum AssetStatus {
  PENDING
  READY
  FAILED
  DELETED
}

model Profile {
  id              String               @id @default(uuid())
  slug            String               @unique
  fullName        String
  headline        String
  summary         String
  location        String
  availability    String
  yearsExperience Int
  version         Int                  @default(1)
  translations    ProfileTranslation[]
  skills          Skill[]
  experiences     Experience[]
  caseStudies     CaseStudy[]
  socialLinks     SocialLink[]
  assets          Asset[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

/// Locale projection of the profile. The base columns stay authoritative and
/// are used when a locale has no row, so adding a language is additive.
model ProfileTranslation {
  id           String  @id @default(uuid())
  profileId    String
  locale       String
  headline     String
  summary      String
  location     String
  availability String
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale])
}

model Skill {
  id        String                @id @default(uuid())
  profileId String
  name      String
  category  String
  priority  Int
  profile   Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cases     CaseStudyTechnology[]

  @@unique([profileId, name])
}

model Experience {
  id           String                  @id @default(uuid())
  profileId    String
  companyLabel String
  role         String
  startDate    DateTime
  endDate      DateTime?
  summary      String
  sortOrder    Int
  profile      Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  highlights   ExperienceHighlight[]
  translations ExperienceTranslation[]
}

model ExperienceTranslation {
  id           String     @id @default(uuid())
  experienceId String
  locale       String
  summary      String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, locale])
}

model ExperienceHighlight {
  id           String                           @id @default(uuid())
  experienceId String
  title        String
  description  String
  sortOrder    Int
  experience   Experience                       @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  translations ExperienceHighlightTranslation[]
}

model ExperienceHighlightTranslation {
  id          String              @id @default(uuid())
  highlightId String
  locale      String
  title       String
  description String
  highlight   ExperienceHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@unique([highlightId, locale])
}

model CaseStudy {
  id           String                 @id @default(uuid())
  profileId    String
  slug         String                 @unique
  featured     Boolean                @default(false)
  sortOrder    Int
  version      Int                    @default(1)
  profile      Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  translations CaseStudyTranslation[]
  metrics      CaseStudyMetric[]
  technologies CaseStudyTechnology[]
  assets       Asset[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model CaseStudyTranslation {
  id           String    @id @default(uuid())
  caseStudyId  String
  locale       String
  title        String
  problem      String
  constraints  String
  approach     String
  architecture String
  result       String
  scaleNotes   String
  caseStudy    CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)

  @@unique([caseStudyId, locale])
}

model CaseStudyMetric {
  id          String    @id @default(uuid())
  caseStudyId String
  label       String
  value       String
  unit        String
  sortOrder   Int
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
}

model CaseStudyTechnology {
  caseStudyId String
  skillId     String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([caseStudyId, skillId])
}

model SocialLink {
  id        String  @id @default(uuid())
  profileId String
  type      String
  url       String
  sortOrder Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Asset {
  id          String      @id @default(uuid())
  profileId   String
  caseStudyId String?
  type        String
  status      AssetStatus @default(PENDING)
  storageKey  String      @unique
  contentType String
  sizeBytes   BigInt?
  checksum    String?
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  caseStudy   CaseStudy?  @relation(fields: [caseStudyId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model GithubSnapshot {
  id         String    @id @default(uuid())
  owner      String
  repository String
  stars      Int
  forks      Int
  openIssues Int
  pushedAt   DateTime?
  capturedAt DateTime  @default(now())

  @@index([owner, capturedAt])
}

model Deployment {
  id          String       @id @default(uuid())
  sha         String
  branch      String
  environment String
  status      String
  startedAt   DateTime
  finishedAt  DateTime?
  qualityRuns QualityRun[]

  @@unique([sha, environment])
  @@index([environment, startedAt])
}

model QualityRun {
  id                      String     @id @default(uuid())
  deploymentId            String
  sha                     String
  unitTests               Int
  integrationTests        Int
  contractTests           Int
  e2eTests                Int
  securityTests           Int
  coverageLines           Float
  coverageBranches        Float
  lighthousePerformance   Int
  lighthouseAccessibility Int
  bundleKb                Int
  criticalVulnerabilities Int
  highVulnerabilities     Int
  createdAt               DateTime   @default(now())
  deployment              Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sha])
}

model SystemEvent {
  id            String   @id @default(uuid())
  type          String
  severity      String
  publicPayload Json
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model PerformanceSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  metric         String   @db.String(8)
  value          Float
  rating         String   @db.String(16)
  navigationType String?  @db.String(32)
  createdAt      DateTime @default(now())

  @@index([metric, createdAt])
}
