{
  "name": "@sskutushev/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs && node scripts/build-evidence.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run src",
    "test:report": "vitest run src --coverage --coverage.reporter=json-summary --coverage.reportsDirectory=../../artifacts/web-coverage --coverage.thresholds.lines=20 --coverage.thresholds.branches=55 --reporter=json --outputFile=../../artifacts/web-tests.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.1.2",
    "@tanstack/react-query": "^5.75.4",
    "graphql": "^16.14.2",
    "graphql-request": "^7.1.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.37.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0",
    "web-vitals": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.25.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.26",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
