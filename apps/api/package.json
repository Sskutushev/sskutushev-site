{
  "name": "@sskutushev/api",
  "private": true,
  "files": [
    "dist",
    "prisma",
    "package.json"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:report": "vitest run --coverage --coverage.reporter=json-summary --coverage.reportsDirectory=../../artifacts/api-coverage --coverage.thresholds.lines=40 --coverage.thresholds.branches=60 --reporter=json --outputFile=../../artifacts/api-tests.json"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.804.0",
    "@aws-sdk/s3-request-presigner": "^3.804.0",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@prisma/client": "^6.7.0",
    "bullmq": "^5.51.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.2.1",
    "ioredis": "^5.6.1",
    "pino-http": "^10.4.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.12",
    "ws": "^8.21.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.25.1",
    "typescript-eslint": "^8.31.1",
    "vitest": "^3.1.3"
  }
}
